# Local development works with all optional integrations blank.
APP_NAME=reentry
APP_ENV=development
PORT=3000
LOG_LEVEL=info

# Optional: Axiom application log viewer. Server-side only.
AXIOM_TOKEN=
AXIOM_DATASET=
AXIOM_EDGE=us-east-1.aws.edge.axiom.co
LOG_DASHBOARD_URL=https://app.axiom.co/

# Optional: OTLP-compatible trace collector. Leave empty to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=reentry

# Local extension connection; these are public identifiers, not secrets.
REENTRY_APP_ORIGIN=http://127.0.0.1:3000
REENTRY_EXTENSION_ID=nabinfdlobegbkgehppcipkhbddjbdka

# Optional local AI recovery. Default disabled keeps manual recovery available.
# Set both provider and an installed model id to enable Phase 3.
REENTRY_AI_PROVIDER=disabled
REENTRY_AI_MODEL=
REENTRY_AI_ENDPOINT=http://127.0.0.1:11434
REENTRY_AI_THINK=false
REENTRY_AI_TIMEOUT_MS=30000
