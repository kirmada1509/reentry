# Local development works with all optional integrations blank.
APP_NAME=reentry
APP_ENV=development
PORT=3000
LOG_LEVEL=info

# Optional: Axiom application log viewer. Server-side only.
AXIOM_TOKEN=
AXIOM_DATASET=
AXIOM_EDGE=us-east-1.aws.edge.axiom.co
LOG_DASHBOARD_URL=https://app.axiom.co/

# Optional: OTLP-compatible trace collector. Leave empty to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=reentry
