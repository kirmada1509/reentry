{
  "name": "reentry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "new": "node scripts/new-project.mjs",
    "dev": "node scripts/serve.mjs dev",
    "dev:start": "node scripts/dev.mjs start",
    "dev:stop": "node scripts/dev.mjs stop",
    "dev:status": "node scripts/dev.mjs status",
    "dev:logs": "node scripts/dev.mjs logs",
    "build": "next build",
    "start": "node scripts/serve.mjs start",
    "start:managed": "node scripts/dev.mjs start --production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui:add": "node scripts/ui-add.mjs",
    "ui:check": "node scripts/check-ui.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "secrets:staged": "node scripts/check-secrets.mjs --staged",
    "agent:context": "node scripts/agent-context.mjs",
    "logs:open": "node scripts/logs-open.mjs",
    "observe:smoke": "node scripts/cloud-smoke.mjs",
    "smoke": "node scripts/http-smoke.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm ui:check && pnpm secrets:check && pnpm agent:context",
    "verify": "pnpm check && pnpm build",
    "prepare": "husky",
    "setup:check": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@axiomhq/js": "1.8.0",
    "@axiomhq/logging": "0.4.1",
    "@next/env": "16.4.2",
    "@opentelemetry/api": "1.9.1",
    "@tabler/icons-react": "3.49.0",
    "@vercel/otel": "2.1.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.5.1",
  "description": "An accessible recovery card for returning to interrupted work.",
  "license": "MIT",
  "engines": {
    "node": ">=22.14 <25",
    "pnpm": ">=12 <13"
  },
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.2",
      "onFail": "download"
    }
  }
}
