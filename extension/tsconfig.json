{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@reentry/*": ["../src/*"],
      "@/components/*": ["../src/components/*"]
    },
    "jsx": "react-jsx"
  }
}
